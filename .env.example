# Base de datos (Neon)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."   # URL directa (sin pooler), para migraciones Prisma

# Cifrado reversible de contraseñas de jueces (32 bytes, base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Firma de sesiones JWT (32 bytes, base64)
JWT_SECRET=""

# SMTP (envío de credenciales a jueces). Funciona con cualquier proveedor.
#
# Brevo (recomendado, no requiere dominio propio):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<el login SMTP que muestra Brevo> (suele ser tu correo de la cuenta)
#   SMTP_PASS=<la "SMTP key" / Master password generada en Brevo>
#   MAIL_FROM=<la dirección de remitente VERIFICADA en Brevo>
#
# Gmail (alternativa; usa App Password de 16 caracteres):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=<cuenta de Gmail>
#   SMTP_PASS=<App Password de https://myaccount.google.com/apppasswords>
#
# Si SMTP_HOST/SMTP_PORT se omiten, se usa Gmail (smtp.gmail.com:465).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""

# Pausa entre correos del envío masivo, en milisegundos (opcional, default 700).
MAIL_SEND_DELAY_MS=""

# URL pública de la app (opcional). Si está definida, los emails de
# credenciales incluyen un enlace de login. Ej. "https://mision-votum.vercel.app"
APP_URL=""

# Seed del admin (usado solo por el script de seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""   # contraseña inicial; se hashea con bcrypt al ejecutar seed

# Secreto del cron de Vercel que mantiene viva la SMTP key de Brevo.
# Vercel manda "Authorization: Bearer <CRON_SECRET>" al llamar el cron.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
