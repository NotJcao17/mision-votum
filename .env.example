# Base de datos (Neon)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."   # URL directa (sin pooler), para migraciones Prisma

# Cifrado reversible de contraseñas de jueces (32 bytes, base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Firma de sesiones JWT (32 bytes, base64)
JWT_SECRET=""

# Resend
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Seed del admin (usado solo por el script de seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""   # contraseña inicial; se hashea con bcrypt al ejecutar seed
