# Base de datos (Neon)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."   # URL directa (sin pooler), para migraciones Prisma

# Cifrado reversible de contraseñas de jueces (32 bytes, base64)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Firma de sesiones JWT (32 bytes, base64)
JWT_SECRET=""

# SMTP de Gmail (envío de credenciales a jueces).
# SMTP_USER: la cuenta de Gmail (ej. misionvotum@gmail.com).
# SMTP_PASS: "Contraseña de aplicación" de 16 caracteres generada en
#            https://myaccount.google.com/apppasswords
#            (requiere activar antes verificación en 2 pasos en la cuenta).
SMTP_USER=""
SMTP_PASS=""

# URL pública de la app (opcional). Si está definida, los emails de
# credenciales incluyen un enlace de login. Ej. "https://mision-votum.vercel.app"
APP_URL=""

# Seed del admin (usado solo por el script de seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""   # contraseña inicial; se hashea con bcrypt al ejecutar seed
